          "zh": "鞋"
        },
        {
          "id": "hat",
          "zh": "帽子"
        }
      ],
      "phrase": {
        "id": "my-bag",
        "text": "My bag.",
        "zh": "我的书包。"
      },
      "game": {
        "title": "出门前小帮手",
        "text": "把孩子的书包、鞋子和帽子放在面前。家长慢慢说 “bag”，请孩子指一指；再抱起书包说 “My bag.”。一起穿鞋、戴帽，准备好再出门。"
      }
    },
