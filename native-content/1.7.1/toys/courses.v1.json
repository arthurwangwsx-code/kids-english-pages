  "lessons": [
    {
      "id": "toys",
      "title": "玩具时间",
      "subtitle": "选一个玩具，听一听，再和家长一起找。",
      "words": [
        {
          "id": "ball",
          "zh": "球"
        },
        {
          "id": "car",
          "zh": "小汽车"
        },
        {
          "id": "teddy",
          "zh": "玩具熊"
        }
      ],
      "phrase": {
        "id": "a-ball",
        "text": "A ball!",
        "zh": "一个球！"
      },
      "game": {
        "title": "滚一滚球",
        "text": "家长和孩子面对面坐下，慢慢把球滚给对方。家长说 “ball”，再说 “A ball!”。孩子可以指一指、接住球，或者自愿跟着说。"
      }
    },
    {
      "id": "water-time",
      "title": "喝水时间",
      "subtitle": "喝口水，也说一句谢谢",
      "words": [
        {
          "id": "water",
          "zh": "水"
        },
        {
          "id": "cup",
          "zh": "杯子"
        },
        {
          "id": "drink",
          "zh": "喝水"
        }
      ],
      "phrase": {
        "id": "water-please",
        "text": "Water, please.",
        "zh": "我想喝水，请给我水。"
      },
      "game": {
        "title": "给小熊倒杯水",
        "text": "家长准备不烫的饮用水和不易碎的杯子，一起指一指杯子和水。家长说 “Water, please.”，再帮孩子喝一口。也可以用空杯子假装给玩具熊喝水。"
      }
    },
    {
      "id": "meal",
      "title": "吃饭时间",
      "subtitle": "看一看我们的小餐盘",
      "words": [
        {
          "id": "rice",
          "zh": "米饭"
        },
        {
          "id": "banana",
          "zh": "香蕉"
        },
        {
          "id": "egg",
          "zh": "鸡蛋"
        }
      ],
      "phrase": {
        "id": "more-please",
        "text": "More, please.",
        "zh": "请再给我一点。"
      },
      "game": {
        "title": "餐盘里找一找",
        "text": "在家长准备的餐点旁，指一指米饭、香蕉或鸡蛋。家长说出对应英语，再示范 “More, please.”。按平时饮食习惯进餐，孩子只指一指也可以。"
      }
    },
    {
      "id": "outside",
      "title": "出门时间",
      "subtitle": "带上小书包，一起出发",
      "words": [
        {
          "id": "bag",
          "zh": "书包"
        },
        {
          "id": "shoes",
          "zh": "鞋"
        },
        {
          "id": "hat",
          "zh": "帽子"
        }
      ],
      "phrase": {
        "id": "my-bag",
        "text": "My bag.",
        "zh": "我的书包。"
      },
      "game": {
        "title": "出门前小帮手",
        "text": "把孩子的书包、鞋子和帽子放在面前。家长慢慢说 “bag”，请孩子指一指；再抱起书包说 “My bag.”。一起穿鞋、戴帽，准备好再出门。"
      }
    },
    {
      "id": "school",
