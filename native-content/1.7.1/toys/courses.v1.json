      "subtitle": "发现书、椅子和小桌子",
      "words": [
        {
          "id": "book",
          "zh": "书"
        },
        {
          "id": "chair",
          "zh": "椅子"
        },
        {
          "id": "table",
          "zh": "桌子"
        }
      ],
      "phrase": {
        "id": "sit-down",
        "text": "Sit down.",
        "zh": "请坐下。"
      },
      "game": {
        "title": "坐下来读一本书",
        "text": "找一张适合孩子的稳固椅子，在小桌子旁放一本绘本。家长说 “Sit down.”，和孩子坐下来，指一指 book、chair 和 table，再一起翻一页。"
      }
    },
    {
